{
  "name": "lawpex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/generate-case-catalog.ts",
    "prebuild": "tsx scripts/generate-case-catalog.ts",
    "dev": "tsx scripts/serve.ts",
    "dev:admin": "tsx scripts/serve-admin.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild scripts/serve.ts --bundle --platform=node --format=cjs --packages=external --define:import.meta.env=undefined --sourcemap --outfile=dist/server.cjs",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build:all": "npm run build && npm run build:admin",
    "start:admin": "node scripts/start-admin.cjs",
    "db:init": "tsx scripts/init-database.ts",
    "admin:credentials": "tsx scripts/admin-password.ts",
    "test:publishing": "tsx --test tests/shared-publishing.test.ts tests/published-case-client.test.ts",
    "preview:publishing": "tsx tests/publishing-preview.ts",
    "test:browser:publishing": "node tests/shared-publishing.browser.mjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "docx-preview": "^0.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.4.299",
    "pg": "8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "vite": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
