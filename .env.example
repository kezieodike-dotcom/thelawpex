# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model used for all AI endpoints. Optional.
# Defaults to gemini-2.5-flash if unset.
GEMINI_MODEL="gemini-2.5-flash"

# PORT: Port the LAWPEX server listens on. Optional. Defaults to 3000.
PORT="3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Shared publishing (server-only). Both site deployments must use the same database.
# Use a pooled PostgreSQL connection URL with TLS configured by your provider.
DATABASE_URL=""
ADMIN_EMAIL=""
# Run npm run admin:credentials to generate a password hash and session secret.
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""
# Required in production for secure, same-origin admin actions.
ADMIN_URL="https://admin.lawpex.com"

# Public URLs only; VITE_ values are included in frontend builds.
VITE_ADMIN_SITE_URL="https://admin.lawpex.com"
VITE_PUBLIC_SITE_URL="https://lawpex.com"
# For local development, use http://localhost:3001 and http://localhost:3000 above,
# and set APP_URL=http://localhost:3000 and ADMIN_URL=http://localhost:3001.
